{
  "name": "dermaintegrate-app",
  "version": "1.0.0",
  "description": "DermaIntegrate 应用平台域 - Node/Express 代理层",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node src/app.js",
    "seed": "node src/db/seed/index.js",
    "migrate:rag": "node scripts/run_rag_migrations.js",
    "verify:rag-schema": "node scripts/verify_rag_schema.js",
    "verify:rag-contract": "node scripts/verify_rag_v1_contract.js",
    "seed:test-doctor-sql": "node scripts/run_sql_file.js src/db/seed/sql/20260721_test_doctors_and_kb_permissions.sql",
    "seed:test-doctor-docs": "node scripts/seed_test_doctor_documents.js",
    "seed:test-doctor-data": "npm run seed:test-doctor-sql && npm run seed:test-doctor-docs",
    "rollback:test-doctor-data": "node scripts/seed_test_doctor_documents.js --cleanup-files && node scripts/run_sql_file.js src/db/seed/sql/20260721_test_doctors_and_kb_permissions.rollback.sql"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.4",
    "mysql2": "^3.6.5",
    "nanoid": "^3.3.15",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
